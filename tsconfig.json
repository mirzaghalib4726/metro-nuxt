{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "types": ["@nuxt/types", "@nuxtjs/color-mode/types/vue.d.ts"],
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ],
    "paths": {
      "#app": ["./node_modules/nuxt/dist/app"]
    }
  },
  "include": [
    "./components/**/*.ts",
    "./components/**/*.d.ts",
    "./components/**/*.vue",
    "./composables/**/*.ts",
    "./composables/**/*.d.ts",
    "./layouts/**/*.vue",
    "./middleware/**/*.ts",
    "./pages/**/*.vue",
    "./plugins/**/*.ts",
    "./server/**/*.ts",
    "./server/**/*.d.ts",
    "./types/**/*.d.ts",
    "./types/**/*.ts",
    "./app.vue",
    "./error.vue"
  ],
  "exclude": ["node_modules"]
}
